{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main",
    "oauth_window",
    "mini"
  ],
  "permissions": [
    "core:default",
    "core:event:allow-emit",
    "core:event:allow-listen",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:webview:allow-webview-close",
    "sql:default",
    "sql:allow-execute",
    "core:webview:allow-create-webview-window",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-visible-on-all-workspaces",
    "core:menu:allow-set-as-app-menu",
    "core:menu:allow-popup",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://api-partner.spotify.com/*"
        },
        {
          "url": "https://clienttoken.spotify.com/*"
        },
        {
          "url": "https://open.spotify.com/*"
        },
        {
          "url": "https://open.spotifycdn.com/*"
        },
        {
          "url": "https://spclient.wg.spotify.com/*"
        }
      ]
    }
  ]
}
